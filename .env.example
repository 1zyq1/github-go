# Copy to .env and adjust. No secrets belong in this file: the service never
# needs tokens, and every value below is a plain tunable or a file path.
# All settings use the GITHUB_ACCELERATOR_ prefix.

# Directory that contains a built single-page app. Leave it pointing at a
# missing path to run the service in API-only mode.
GITHUB_ACCELERATOR_STATIC_DIR=frontend/dist

# Outbound transport limits, in whole seconds.
GITHUB_ACCELERATOR_CONNECT_TIMEOUT_SECONDS=10
GITHUB_ACCELERATOR_READ_TIMEOUT_SECONDS=300
GITHUB_ACCELERATOR_POOL_TIMEOUT_SECONDS=10

# Upstream connection pool and the number of simultaneous proxied downloads.
# GITHUB_ACCELERATOR_MAX_KEEPALIVE_CONNECTIONS must not exceed
# GITHUB_ACCELERATOR_MAX_CONNECTIONS.
GITHUB_ACCELERATOR_MAX_CONNECTIONS=16
GITHUB_ACCELERATOR_MAX_KEEPALIVE_CONNECTIONS=8
GITHUB_ACCELERATOR_MAX_CONCURRENT_PROXIES=8

# Outbound User-Agent sent to GitHub.
GITHUB_ACCELERATOR_USER_AGENT=github-accelerator/0.1

# Immutable archive payloads are cached on disk so repeat downloads never hit
# codeload again. This directory must be writable by the service user; set the
# cap to 0 to disable caching entirely.
GITHUB_ACCELERATOR_ARCHIVE_CACHE_DIR=.cache/archives
GITHUB_ACCELERATOR_ARCHIVE_CACHE_MAX_BYTES=21474836480

# Every request is attributed to an account. Registration is open, and each
# account may spend the allowance below per rolling window. A use is only
# counted when content is actually fetched, so resolving a link or probing with
# HEAD is free.
GITHUB_ACCELERATOR_USAGE_LIMIT=10
GITHUB_ACCELERATOR_USAGE_WINDOW_SECONDS=3600
GITHUB_ACCELERATOR_SESSION_TTL_SECONDS=2592000

# Accounts, sessions, the usage quota, and the published statistics all live in
# MySQL, whose tables are created on first use. TABLE_PREFIX namespaces every
# table so that a test run can share one database with the product; leave it
# empty for the product tables. The pool bounds how many connections one
# process holds, and MIN_SIZE must not exceed MAX_SIZE.
GITHUB_ACCELERATOR_MYSQL_HOST=127.0.0.1
GITHUB_ACCELERATOR_MYSQL_PORT=3306
GITHUB_ACCELERATOR_MYSQL_USER=
GITHUB_ACCELERATOR_MYSQL_PASSWORD=
GITHUB_ACCELERATOR_MYSQL_DATABASE=
GITHUB_ACCELERATOR_MYSQL_TABLE_PREFIX=
GITHUB_ACCELERATOR_MYSQL_POOL_MIN_SIZE=1
GITHUB_ACCELERATOR_MYSQL_POOL_MAX_SIZE=10

# Set to true once the service is served over HTTPS, so the session cookie is
# never sent in clear text.
GITHUB_ACCELERATOR_SESSION_COOKIE_SECURE=false

# Registration mails a confirmation link, and an account cannot sign in until
# its address is confirmed. The link is built from PUBLIC_BASE_URL, so that
# value must be the address users actually reach. VERIFICATION_TTL_SECONDS is
# how long a link stays usable; VERIFICATION_RESEND_SECONDS is the cooldown
# between two mails for one account (0 allows immediate resends).
GITHUB_ACCELERATOR_PUBLIC_BASE_URL=http://127.0.0.1:8000
GITHUB_ACCELERATOR_VERIFICATION_TTL_SECONDS=86400
GITHUB_ACCELERATOR_VERIFICATION_RESEND_SECONDS=60

# SMTP transport for the confirmation mail. Leave SMTP_HOST empty to run
# without a mail server: the link is then written to the service log instead of
# being sent, which is convenient for local development. With a host set,
# either SMTP_FROM or SMTP_USERNAME must hold the sender address. Port 587 with
# STARTTLS is the common case; set SMTP_STARTTLS=false for implicit TLS on port
# 465. Works with QQ 邮箱, 163, 腾讯企业邮, Gmail, and Resend's SMTP.
GITHUB_ACCELERATOR_SMTP_HOST=
GITHUB_ACCELERATOR_SMTP_PORT=587
GITHUB_ACCELERATOR_SMTP_USERNAME=
GITHUB_ACCELERATOR_SMTP_PASSWORD=
GITHUB_ACCELERATOR_SMTP_FROM=
GITHUB_ACCELERATOR_SMTP_STARTTLS=true

# Comma-separated hosts allowed to reach the service through the ASGI
# TrustedHost middleware. Leave empty to accept any Host header.
GITHUB_ACCELERATOR_TRUSTED_HOSTS=

# Cross-site single sign-on with the 1zyq1 blog. Both services must share the
# same SSO_SHARED_SECRET (generate one, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# Leave empty to disable SSO entirely (the "用博客账号登录" button is hidden).
GITHUB_ACCELERATOR_SSO_SHARED_SECRET=
# The defaults mirror the blog's defaults, so normally only the secret is needed:
#   GITHUB_ACCELERATOR_SSO_ISSUER=github-accelerator
#   GITHUB_ACCELERATOR_SSO_AUDIENCE=blog
#   GITHUB_ACCELERATOR_SSO_PEER_AUTHORIZE_URL=https://api.blog.1zyq1.com/api/sso/authorize
#   GITHUB_ACCELERATOR_SSO_PEER_CALLBACK_URL=https://api.blog.1zyq1.com/api/sso/callback
#   GITHUB_ACCELERATOR_SSO_SELF_CALLBACK_URL=
#   GITHUB_ACCELERATOR_SSO_ASSERTION_TTL_SECONDS=300

# Blog-credit redemption: when the hourly allowance runs out, a signed-in visitor
# can spend blog credits (billed by the blog backend) for extra attempts here.
# REDEEM_CREDITS is deducted from the blog balance and REDEEM_ATTEMPTS is added
# to this account's bonus reserve (usable once the window is full).
GITHUB_ACCELERATOR_REDEEM_CREDITS=10
GITHUB_ACCELERATOR_REDEEM_ATTEMPTS=10
# Blog backend base URL for the server-to-server call. Same secret as SSO.
GITHUB_ACCELERATOR_BLOG_API_BASE_URL=https://api.blog.1zyq1.com
