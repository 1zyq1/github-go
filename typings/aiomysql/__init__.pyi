# Type stubs for the slice of ``aiomysql`` this application uses.
#
# ``aiomysql`` ships no ``py.typed`` marker and keeps only partial annotations,
# so a strict checker sees ``Unknown`` on every pool, connection, and cursor
# member. Declaring the surface here keeps ``typeCheckingMode = "all"``
# meaningful for the whole project instead of relaxing it for the one module
# that talks to MySQL. Rows are plain tuples, which is why ``fetchone`` and
# ``fetchall`` return ``tuple[object, ...]`` rather than a mapping type.

from collections.abc import Sequence
from types import TracebackType
from typing import Protocol, Self

class Error(Exception): ...
class InterfaceError(Error): ...
class DatabaseError(Error): ...
class DataError(DatabaseError): ...
class OperationalError(DatabaseError): ...
class IntegrityError(DatabaseError): ...
class InternalError(DatabaseError): ...
class ProgrammingError(DatabaseError): ...
class NotSupportedError(DatabaseError): ...

class Cursor(Protocol):
    lastrowid: int | None
    rowcount: int
    async def execute(self, query: str, args: Sequence[object] | None = None) -> int: ...
    async def executemany(
        self, query: str, args: Sequence[Sequence[object]]
    ) -> int: ...
    async def fetchone(self) -> tuple[object, ...] | None: ...
    async def fetchall(self) -> list[tuple[object, ...]]: ...
    async def fetchmany(self, size: int | None = None) -> list[tuple[object, ...]]: ...
    async def close(self) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...

class Connection(Protocol):
    def cursor(self) -> Cursor: ...
    async def begin(self) -> None: ...
    async def commit(self) -> None: ...
    async def rollback(self) -> None: ...
    async def ping(self, reconnect: bool = True) -> None: ...
    def close(self) -> None: ...

class _AcquiredConnection(Protocol):
    async def __aenter__(self) -> Connection: ...
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> None: ...

class Pool(Protocol):
    def acquire(self) -> _AcquiredConnection: ...
    def close(self) -> None: ...
    async def wait_closed(self) -> None: ...

async def connect(
    *,
    host: str = "localhost",
    port: int = 3306,
    user: str = "",
    password: str = "",
    db: str = "",
    charset: str = "utf8mb4",
    autocommit: bool = False,
    connect_timeout: float = 10.0,
) -> Connection: ...
async def create_pool(
    minsize: int = 1,
    maxsize: int = 10,
    echo: bool = False,
    pool_recycle: int = -1,
    *,
    host: str = "localhost",
    port: int = 3306,
    user: str = "",
    password: str = "",
    db: str = "",
    charset: str = "utf8mb4",
    autocommit: bool = False,
    connect_timeout: float = 10.0,
) -> Pool: ...
